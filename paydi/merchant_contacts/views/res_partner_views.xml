    <!--        <function-->
    <!--                id="load_pos_machine"-->
    <!--                model="res.partner"-->
    <!--                name="load_pos_machine"/>-->
    <!--    </data>-->
    <record id="merchant_partner_search_view" model="ir.ui.view">
        <field name="name">merchant_partner_search_view</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='type_person']" position="before">
                <filter name="obj_type_filter" string="Đối tác Pos" domain="[('obj_type', '=', 'merchant')]"/>
            </xpath>
        </field>
    </record>


    <record id="view_merchant_partner_form" model="ir.ui.view">
        <field name="name">res.partner.carrier.merchant.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group/field[@name='type']" position="before">
                <field name="obj_type"/>

                <field name="company_vn_name"
                       placeholder="Tên đăng ký kinh doanh-Tiếng việt"
                       attrs="{'invisible': [('is_company','=', False)]}"/>

                <field name="company_en_name"
                       placeholder="Tên đăng ký kinh doanh-Tiếng anh"
                       attrs="{'invisible': [('is_company','=', False)]}"/>

                <field name="business_type" attrs="{'invisible': [('is_company','=', False)]}"/>
            </xpath>

            <xpath expr="//field[@name='vat']" position="before">
                <field name="registration_number"
                       attrs="{'invisible': [('is_company','=', False)], 'required': [('obj_type','=', 'merchant')]}"/>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <page string="Dịch vụ khác"
                      name="other_service">
                    <group attrs="{'invisible': [('obj_type','!=', 'merchant')]}">
                        <field name="service_ids"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

    <record id="action_merchant_contacts_view_kanban" model="ir.actions.act_window.view">
        <field name="sequence" eval="0"/>
        <field name="view_mode">kanban</field>
        <field name="view_id" ref="base.res_partner_kanban_view"/>
        <field name="act_window_id" ref="action_merchant_contacts"/>
    </record>

    <record id="action_merchant_contacts_view_tree" model="ir.actions.act_window.view">
        <field name="sequence" eval="1"/>
        <field name="view_mode">tree</field>
        <field name="view_id" ref="base.view_partner_tree"/>
        <field name="act_window_id" ref="action_merchant_contacts"/>
    </record>

    <record id="action_merchant_contacts_view_form" model="ir.actions.act_window.view">
        <field name="sequence" eval="2"/>
        <field name="view_mode">form</field>
        <field name="view_id" ref="base.view_partner_form"/>
        <field name="act_window_id" ref="action_merchant_contacts"/>
    </record>




