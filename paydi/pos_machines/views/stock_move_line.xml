<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_account_partner_form" model="ir.ui.view">
        <field name="name">stock.move.line.form.inherit</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.view_stock_move_line_detailed_operation_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='lot_name']"
                   position="after">

                <field
                        name="is_setup"
                        invisible="1"
                />

                <field
                        name="account"
                        attrs="{'invisible': ['|',('account','=', False), ('is_setup', '=', False)]}"
                />

                <button class="oe_highlight"
                        name="gen_account"
                        string="Cài đặt máy"
                        attrs="{'invisible': ['|', '|',('account','!=', False), ('is_setup','=', False), ('state' ,'=', 'done'), ( 'is_locked' , '=', True)]}"
                        context="{
                               'default_lot_id': lot_id,
                               'default_lot_name': lot_name
                              }"
                        type="object"/>

            </xpath>
        </field>
    </record>
    <record id="view_picking_form_validate" model="ir.ui.view">
        <field name="name">view_picking_form_validate</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='button_validate']" position="attributes">
                <attribute name="confirm">Bạn có chắc chắn hoàn thành phiếu.</attribute>
            </xpath>
        </field>
    </record>
</odoo>