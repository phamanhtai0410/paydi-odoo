<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="pos_machine_setting_wizard_form_view" model="ir.ui.view">
            <field name="name">Cài đặt máy</field>
            <field name="model">pos.machine.setting.wizard</field>
            <field name="arch" type="xml">
                <form create="false" edit="false">
                    <sheet>
                        <div class="oe_title">
                            <label for="serial_number"/>
                            <h1>
                                <field name="serial_number"/>
                            </h1>
                        </div>
                        <group>
                            <field name="partner"/>
                            <field name="tid_mid"/>
                        </group>
                    </sheet>
                    <footer>

                        <button attrs="{'invisible':[('tid','!=',False), ('mid','!=',False)]}"
                                string="Lưu cài đặt và tạo tài khoản Paydi"
                                special="Confirm"
                                confirm="Bạn có chắc muốn tạo tài khoản cho máy POS với TID, MID đã nhập?"
                                type="object" class="btn-primary"/>

                        <button string="Cancel" class="btn-default" special="cancel"/>

                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>