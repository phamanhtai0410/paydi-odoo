<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="pos_machines_form_view" model="ir.ui.view">
            <field name="name">pos.machines.form</field>
            <field name="model">pos.machines</field>
            <field name="arch" type="xml">
                <form string="Thông tin máy">
                    <sheet>

                        <div class="oe_title">
                            <label string="Mã máy" for="serial_number"/>
                            <h1>
                                <field name="serial_number" placeholder="ex: 000000"/>
                            </h1>
                        </div>

                        <group>

                            <group string="Thông tin cơ bản">
                                <field name="factory"/>
                                <field name="model"/>
                                <field name="assets_code"/>
                                <field name="status"/>
                            </group>

                            <group string="Thông tin kho">
                                <field name="warehouse"/>
                                <field name="create_date">
                                    <attribute name="string">Ngày tạo</attribute>
                                </field>
                                <field name="create_uid">
                                    <attribute name="string">Người tạo</attribute>
                                </field>
                            </group>

                            <group string="Thông tin kỹ thuật" attrs="{'invisible': [('status','!=', 'has_setup')]}">
                                <field name="tid"/>
                                <field name="mid"/>
                                <field name="pos_account"/>
                            </group>

                            <group string="Thông tin lắp đặt" attrs="{'invisible': [('status','!=', 'has_setup')]}">
                                <field name="counter"/>
                                <field name="floor"/>
                                <field name="house_number"/>
                                <field name="street"/>
                                <field name="zip"/>
                                <field name="city"/>
                                <field name="country_id"/>
                            </group>

                        </group>
                    </sheet>
                    <div class="oe_chatter">
                        <field name="message_follower_ids"/>
                        <field name="activity_ids"/>
                        <field name="message_ids" options="{'post_refresh': 'recipients'}"/>
                    </div>
                </form>
            </field>
        </record>

        <record id="pos_machines_tree_view" model="ir.ui.view">
            <field name="name">pos.machines.tree</field>
            <field name="model">pos.machines</field>
            <field name="arch" type="xml">
                <tree string="Danh sách máy">
                    <field name="serial_number"/>
                    <field name="status"/>
                </tree>
            </field>
        </record>

        <record id="pos_machines_search_view" model="ir.ui.view">
            <field name="name">pos.machines.search</field>
            <field name="model">pos.machines</field>
            <field name="arch" type="xml">
                <search string="ModelTitle">
                    <group expand="1" string="Group By">
                        <filter string="Trạng thái" name="status" domain="[]"
                                context="{'group_by':'status'}"/>
                    </group>
                </search>
            </field>
        </record>

        <record id="pos_machines_act_window" model="ir.actions.act_window">
            <field name="name">Máy POS</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">pos.machines</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="oe_view_nocontent_create">
                    Quản lý máy POS
                </p>
            </field>
        </record>

        <menuitem
                name="Máy POS"
                id="pos_machines_menu"
                sequence="4"
                groups="base.group_user"
                action="pos_machines_act_window"/>

    </data>
</odoo>