<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="action_res_company" model="ir.actions.act_window">
        <field name="name">res_company</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">res.company</field>
        <field name="view_mode">tree,kanban,form,activity</field>
        <field name="context">{'search_default_obj_type_filter': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a merchant_contact in your address book
            </p>
            <p>
                Odoo helps you to easily track all activities related to a customer.
            </p>
        </field>
    </record>

    <record id="view_res_company_form" model="ir.ui.view">
        <field name="name">res.company.form.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="CRM connections"
                      name="other_service">
                    <group>
                        <field name="company_code"/>
                        <field name="crm_url"/>
                        <field name="username"/>
                        <field name="password"/>
                    </group>
                </page>
            </xpath>
        
        </field>
    </record>

    <menuitem id="menu_res_company"
              name="Quản lý CRM"
              web_icon="merchant_contacts,static/images/icon.png"
              action="action_res_company"
              groups="base.group_user"
              sequence="2"/>


</odoo>
