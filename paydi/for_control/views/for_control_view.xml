<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="for_control_form_view" model="ir.ui.view">
            <field name="name">for.control.form</field>
            <field name="model">for.control</field>
            <field name="arch" type="xml">
                <!-- <form string="Data"> -->
                    <sheet>
                        <notebook>
                            <page name="tab1" string="Đối soát giao dịch">
                                <group name="container_row_2">
                                </group>
                            </page>
                            <page name="tab2" string="Chuyển tiền giao dịch">
                               <field name="field_name"/>
                                <div class="form-row mt-4">
                                    <div class="col-4 mr-3">
                                        <field name="bank"/>
                                    </div>
                                    <div class="col-4 ml-3">
                                        <field name="spending_account"/>
                                    </div>
                                </div>
                                <div class="col-4 mr-3">
                                    
                                </div>
                                <div class="form-row mt-4">
                                    <div class="col-4 mr-3">
                                        <field name="method"/>
                                    </div>
                                    <div class="col-4 ml-3">
                                    </div>
                                </div>
                                
                                <div class="card-body">
                                    <field name="transaction_ids"/>
                                </div>

                                <div class="float-right mt-4">
                                    <!-- <input name="action_from view" role="button" id='submit' class="btn btn-primary btn-md o_website_form_send" value="Xac Nhan"/> -->
                                    <button name="action_from_view" string="Open View" type="object"/> 
                                </div>
                                
                            </page>
                            <page name="tab3" string="Báo cáo ngân hàng">
                               
                            </page>
                        </notebook>
                    </sheet>
                <!-- </form> -->
               
            </field>
        </record>

        <!-- <record id="for_control_form_confirm_view" model="ir.ui.view">
            <field name="name">for.control.confirm.form</field>
            <field name="model">for.control</field>
            <field name="arch" type="xml">
                <field name="bank"/>
            </field>
        </record> -->


        <record id="for_control_act_window" model="ir.actions.act_window">
            <field name="name">Đối Soát Chuyển Tiền</field>
            <field name="type">ir.actions.act_window</field>
            <field name="res_model">for.control</field>
            <field name="view_mode">form,tree</field>
            
        </record>

        <menuitem
                name="For Control"
                id="for_control_menu"
                sequence="4"
                groups="base.group_system"
                web_icon="for_control,static/images/odoo_icon.png"
                action="for_control_act_window"/>

    </data>
</odoo>