<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="modify_view_partner_id_numbers_form" model="ir.ui.view">
        <field name="name">modify.view_partner_id_numbers_form</field>
        <field name="model">res.partner.id_number</field>
        <field name="inherit_id" ref="partner_identification.view_partner_id_numbers_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form/group/field[@name='name']" position="after">
                <field name="position" />
                <field name="Representative_information" />
                <field name="contract_payment_date" />
            </xpath>
        </field>
    </record>
</odoo>