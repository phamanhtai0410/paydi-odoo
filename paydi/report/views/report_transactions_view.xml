<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_report" model="ir.actions.act_window">
        <field name="name">Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.transactions</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Report
            </p>
           
        </field>
    </record>
    
    <record id="action_transactions" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">report.transactions</field>
        <field name="view_mode">tree,kanban,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Transactions
            </p>
           
        </field>
    </record>

    <record id="report_trasactions_view_form" model="ir.ui.view">
        <field name="name">report.transactions.form</field>
        <field name="model">report.transactions</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="tid"/>
                            <field name="mid"/>
                        </group>
                        <group>
                            <field name="pos_id"/>
                            <field name="amount"/>
                        </group>
                        <group>
                            <field name="transaction_err"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="report_trasactions_view_tree" model="ir.ui.view">
        <field name="name">report.transactions.tree</field>
        <field name="model">report.transactions</field>
        <field name="arch" type="xml">
            <tree>
                <field name="tid"/>
                <field name="mid"/>
                <field name="pos_id"/>
                <field name="amount"/>
                <field name="transaction_err"/>
            </tree>
        </field>
    </record>

    <record id="report_trasactions_view_kanban" model="ir.ui.view">
            <field name="name">report.transactions.kanban</field>
            <field name="model">report.transactions</field>
            <field name="arch" type="xml">
                <kanban class="o_kanban_mobile">
                    <field name="tid"/>
                    <field name="mid"/>
                    <field name="pos_id"/>
                    <field name="amount"/>
                    <field name="transaction_err"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div t-attf-class="oe_kanban_card oe_kanban_global_click">
                                <div class="oe_kanban_details">
                                    <ul>
                                        <li>
                                            Mã Terminal          : <field name="tid"/>
                                        </li>
                                        <li>
                                            Mã Merchant          : <field name="tid"/>
                                        </li>
                                        <li>
                                            Mã ID của máy POS    : <field name="pos_id"/>
                                        </li>
                                        <li>
                                            Giá trị giao dịch    : <field name="amount"/> VNĐ
                                        </li>
                                        <li>
                                            Mã lỗi của giao dịch : <field name="transaction_err"/>
                                        </li>
                                    </ul>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>
    

    <menuitem name="Report" 
                id="menu_report" 
                action="action_report"
                sequence="10"/>
    <menuitem name="Transactions" 
                id="menu_report_transactions" 
                parent="menu_report"
                sequence="10"/>
    <menuitem name="Transactions"
                id="res_transaction_menu_report"   
                parent="menu_report_transactions"
                action="action_transactions"
                sequence="2"/>
</odoo>
