<?xml version="1.0" encoding="utf-8"?>
<odoo>  
    <template id="report_page" name="Reports">
        <t t-set="head">
            <meta charset="utf-8"/>
            <meta name="viewport" content="width=device-width, initial-scale=1"/>
            <link rel="stylesheet" href="//code.jquery.com/ui/1.13.0/themes/base/jquery-ui.css"/>
            <script src="https://code.jquery.com/jquery-3.6.0.js"></script>
            <script src="https://code.jquery.com/ui/1.13.0/jquery-ui.js"></script>
            <script
                src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/3.7.0/chart.min.js">
            </script>
            <link rel="stylesheet" type="text/css" href="/report/static/css/transactions_statistic.css"/>
            <script type="text/javascript" src="/report/static/js/date_picker_v2.js"/>
        </t>
        <t t-call="website.layout">
            <div id="loading">
                <div class='uil-ring-css' style='transform:scale(0.79);'>
                    <div></div>
                </div>
            </div> 
            <div class="m-3">
                <label for="from">From</label>
                <input type="text" id="from" name="from"/>
                <label for="to">to</label>
                <input type="text" id="to" name="to"/>
                <button class="" onclick="getCharts()">Get Charts</button>
                <div class="tab">
                    
                    <button class="tablinks" onclick="openTab(event, 'by_method')" id="defaultOpen">By Payment Method</button>
                    <button class="tablinks" onclick="openTab(event, 'by_card_type')">By Card Type</button>
                </div>
                
                <div id="by_method" class="tabcontent">
                                  
                    <canvas id="byMethodTotalTransactionsChart" class="chartCanvas"></canvas>
                    <canvas id="byMethodTotalAmountChart" class="chartCanvas"></canvas>
                </div>
                <div id="by_card_type" class="tabcontent">
                    <canvas id="byCardTypeTotalTransactionsChart" class="chartCanvas"></canvas>
                    <canvas id="byCardTypeTotalAmountChart" class="chartCanvas"></canvas>
                    
                </div>
                <script type="text/javascript" src="/report/static/js/openTabOnly.js"/>
                <script type="text/javascript" src="/report/static/js/drawCharts.js"/>
            </div>
        </t>
    </template>
</odoo>