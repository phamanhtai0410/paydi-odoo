    <template id="list_transactions_page" name="Transactions">
        <t t-set="head">
            <script src="https://ajax.googleapis.com/ajax/libs/jquery/3.5.1/jquery.min.js" ></script>
            <link rel="stylesheet" type="text/css" href="https://cdn.datatables.net/1.11.3/css/jquery.dataTables.css"/>
            <script src="https://cdn.datatables.net/1.11.3/js/jquery.dataTables.js"></script>

        <!-- Add your JS or CSS here for this particular page. -->
            <!-- CSS -->
            <link rel="stylesheet" type="text/css" href="/report/static/css/list_transactions.css"/>
            <!-- JS -->
            <script type="text/javascript">
                
            </script>
            <!-- <script type="text/javascript" src="/report/static/js/openTabTransactions.js"/> -->

        </t>
        <t t-call="website.layout">
            <div class="mx-3">
                <!-- Tab links -->
                
                <div class="tab">
                    <button class="tablinks" onclick="openTab(event, 'transactions')" id="defaultOpen">Successfull Transactions</button>
                    <button class="tablinks" onclick="openTab(event, 'error_transactions')">Error Transactions</button>
                    <button class="tablinks" onclick="openTab(event, 'card_transactions')">Card Transactions</button>
                    <button class="tablinks" onclick="openTab(event, 'pre_auth_transactions')">Pre-Auth Transactions</button>
                </div>
               
                <!-- Tab content -->
                <div id="transactions" class="tabcontent">   
                    <script type="text/javascript" src="/report/static/js/openTabTransactions.js"/>
                    <span onclick="this.parentElement.style.display='none'" class="topright">x</span>
                    <!-- <button onclick="scrollToPager()">Scroll Down</button> -->
                    <div class="scroll" onclick="scrollToPagerOf(this)"></div>
                    <table class="display text-center" id="transactions_table" style="width=100%"></table>
                    <div id="loadingLabel1">Loading...</div>
                </div>

                <div id="error_transactions" class="tabcontent">
                    <span onclick="this.parentElement.style.display='none'" class="topright">x</span>
                    <!-- <button onclick="scrollToErrorPager()">Scroll Down</button> -->
                    <div class="scroll" onclick="scrollToPagerOf(this)"></div>
                    <table class="display text-center" id="error_transactions_table" style="width: 100%"></table> 
                    <div id="loadingLabel2">Loading...</div> 
                </div>

                <div id="card_transactions" class="tabcontent">
                    <span onclick="this.parentElement.style.display='none'" class="topright">x</span>
                    <!-- <button onclick="scrollToCardPager()">Scroll Down</button> -->
                     <div class="scroll" onclick="scrollToPagerOf(this)"></div>
                    <table class="display text-center" id="card_transactions_table" style="width: 100%"></table> 
                    <div id="loadingLabel3">Loading...</div>  
                </div>

                <div id="pre_auth_transactions" class="tabcontent">
                    <span onclick="this.parentElement.style.display='none'" class="topright">x</span>
                    <!-- <button onclick="scrollToPreAuthPager()">Scroll Down</button> -->
                    <div class="scroll" onclick="scrollToPagerOf(this)"></div>
                    <table class="display text-center" id="pre_auth_transactions_table" style="width: 100%"></table>
                    <div id="loadingLabel4">Loading...</div>  
                </div>
            </div>
        </t>
    </template>
</odoo>