            <field name="binding_model_id" ref="model_res_partner"/>
            <field name="binding_type">report</field>
        </record> -->
        <report
            id="res_partner_report_bidv"
            model="res.partner"
            string="Export PDF BIDV"
            report_type="qweb-html"
            name="export_pdf.report_bidv"
            file="export_pdf.report_bidv"
            paperformat="paperformat_bidv_export_landscape"
        />

        <template id="report_bidv">
            <!-- <t t-name="export_pdf.model_res_partner"> -->
            <t t-foreach="docs" t-as="o">
                <t t-call="web.basic_layout">
                    <div class="page">
                    <div style="width:100%;font-family:'Times New Roman', Times, serif; font-size: 16px;">
                        <div>
                        <h3 style="text-align: center; text-decoration-line: underline">Mẫu01/HĐHT/BIDV-MASTER MERCHANT</h3>
                        <h3 style="text-align: center">PHIẾU ĐĂNG KÝ ĐƠN VỊ CHẤP NHẬN THANH TOÁN</h3>
                        </div>
                        
                        <div style="padding-left:5%; padding-right:5%; text-align: justify; padding-top:24px; padding-bottom:24px">
                        <h4>Kính gửi: NGÂN HÀNG TMCP ĐẦUTƯ VÀ PHÁT TRIỂN VIỆT NAM (BIDV)</h4>
                        <p style="margin-top: 24px">Căn cứ Hợp đồng hợp tác triển khai dịch vụ thanh toán thẻ cho ĐVCNTT số: 15732203.0122/BIDV-ONEFIN ngày 14/06/2022 giữa Ngân hàng TMCP Đầutư và Phát triển Việt Nam (BIDV) và (MASTER MERCHANT), MASTER MERCHANT xin gửi BIDV các thông tin đăng ký của ĐVCNTT như sau:</p>
                        </div>
                        
                        <div>
                        <style>
                            table, th, td {
                            border: 1px solid black;
                            border-collapse: collapse;
                            }
                            
                            th, td {
                            text-align: center
                            }
                        </style>
                        <table style="width:100%">
                            <tr>
                            <th rowspan="2">STT</th>
                            <th colspan="4">Đăng ký kinh doanh (ĐKKD)</th>
                            <th colspan="2">Người đại diện</th>
                            <th rowspan="2">MCC</th>
                            <th rowspan="2">Loại hình kinh doanh</th>
                            <th colspan="4">Thông tin thiết bị</th>
                            </tr>
                            <tr>
                            <th>Số ĐKKD</th>
                            <th>Tên đơn vị</th>
                            <th>Địa chỉ</th>
                            <th>Ngành nghề kinh doanh</th>
                            <th>Họ tên</th>
                            <th>Điện thoại</th>
                            <th>Tên in trên hóa đơn</th>
                            <th>Địa chỉ in trên hóa đơn</th>
                            <th>Chủng loại thiết bị</th>
                            <th>SL thiết bị</th>
                            </tr>
                            <tr>
                            <td>1</td>
                            <td><span t-field="o.registration_number"/></td>
                            <td><span t-field="o.company_vn_name"/></td>
                            <td><span t-field="o.street"/>/<span t-field="o.city_id"/></td>
                            <td></td>
                            <td><span t-field="o.x_Presentative_Person"/></td>
                            <td><span t-field="o.phone"/></td>
                            <td>50</td>
                            <td><span t-field="o.industry_id"/></td>
                            <td>50</td>
                            <td>50</td>
                            <td>50</td>
                            <td>50</td>
                            </tr>
                            
                        </table>
                        </div>
                        
                        <div style="padding-left:5%; padding-right:5%; text-align: justify; padding-top:24px; padding-bottom:24px">
                        <p>Chúng tôi cam kết những thông tin cung cấp trên đây là đúng sự thật và hoàn toàn chịu trách nhiệm về toàn bộ các thông tin đã khai báo</p>
                        </div>
                        <div style="width:50%; text-align:center; float: right">
                        <p>Hà Nội, ngày     tháng     năm</p>
                        <h4>ĐẠI DIỆN MASTER MERCHANT</h4>
                        <p style="font-style: oblique">(Ký, ghi rõ họ tên và đóng dấu)</p>
                        </div>
                    </div>
                    </div>
                </t>
            </t>
            <!-- </t> -->
        </template>
    </odoo>