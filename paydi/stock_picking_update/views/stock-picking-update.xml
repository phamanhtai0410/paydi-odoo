<?xml version="1.0" encoding="utf-8"?>
<odoo>
<record id="modify_view_pickingtype_filter" model="ir.ui.view">
        <field name="name">modify.stock.picking.type.filter</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='action_cancel']" position="attributes">
                <attribute name="attrs">{'invisible': [('state', 'not in', ('assigned', 'confirmed', 'partially_available', 'waiting'))]}</attribute>
            </xpath>
        </field>
    </record>
</odoo>