<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="installment_view_search" model="ir.ui.view">
        <field name="name">transaction.installment.view.search</field>
        <field name="model">transaction.installment</field>
        <field name="arch" type="xml">
            <search string="Search">
                <field name="bank" filter_domain="['|', ('bank','ilike',self), ('card_organization','ilike',self)]" string="Bank"/>
                <!-- <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/> -->
                <field name="name_card" filter_domain="[('name_card','ilike',self)]" string="Name"/>
                <field name="contact_id" filter_domain="[('contact_id','ilike',self)]" string="Merchant"/>
            </search>
        </field>
    </record>

    <record model="ir.ui.view" id="transaction_installment_list">
        <field name="name">Transaction list</field>
        <field name="model">transaction.installment</field>
        <field name="arch" type="xml">
            <tree limit="25" create="0" delete="0">
            
                <field name="date_display" />
                <field name="bank" />
                <field name="card_organization"/>
                <field name="name_card" />
                <field name="card_number" />

                <field name="total_amount"/>
                <field name="period" />
                <field name="identity_card"/>
                <field name="approve_code"/>
                <field name="phone"/>
                
            </tree>
        </field>
    </record>


    <record model="ir.ui.view" id="transaction_installment_forcontrol">
        <field name="name">Transaction list</field>
        <field name="model">transaction.installment</field>
        <field name="arch" type="xml">
            <tree limit="25" create="0" delete="0">

                <field name="contact_id" />
                <field name="date_display" />
                <field name="bank" />
                <field name="card_organization"/>
                <field name="name_card" />
                <field name="card_number" />

                <field name="total_amount"/>
                <field name="period" />
                <field name="identity_card"/>
                <field name="approve_code"/>
                <field name="phone"/>
                
            </tree>
        </field>
    </record>


    <record id="action_report_installment" model="ir.actions.act_window">
        <field name="name">Report_Installment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">transaction.installment</field>
        <field name="view_mode">tree,form</field>
        <field name="domain" >[('contact_id.id','=',active_id)]</field>
        <!-- <field name="view_id" ref="transaction_installment_list" /> -->
        <field name="target">inline</field>
        <field name="view_ids" eval="[(5, 0, 0),
                (0, 0, {'view_mode': 'form', 'view_id': ref('transaction_installment_list')})]"/>
                
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Không có dữ liệu
            </p>
            
        </field>
    </record>



</odoo>