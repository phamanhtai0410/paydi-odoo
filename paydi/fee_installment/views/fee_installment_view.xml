<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_res_partner_fee_form" model="ir.ui.view">
        <field name="name">view.res.partner.fee.form</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Tra Gop" name="fee_installment">

                    <form create="true" edit="true" save="true" >
                    <!-- create="false" edit="false" save="false" -->
                        <sheet>
                            <notebook>
                                <page name="tab1" string="Phi">
                                    <div class="card-body">
                                        <!-- <field name="data_tree_file"/> -->
                                        <field name="odoo_contact_id" widget="one2many" nolabel="1">
                                            <tree string="Fee Installment Mapping" limit="10" create="1" delete="1" editable="top">
                                                <!--  create="0" delete="0" -->
                                                <field name="bank" string="Ngan Hang"/>
                                                <field name="period" string="Ky Han(thang)" />
                                                <field name="fee_installment" string="Phi Tra Goi(%)" />
                                                <field name="from_date" string="Ngay Bat Dau" />
                                                <field name="to_date" string="Ngay Ket Thuc" />
                                                
                                            </tree>
                                        </field>
                                    </div>
                                </page>
                                <page name="tab2" string="Bao Cao">
                                
                                </page>
                                
                            </notebook>
                        </sheet>
                    </form>

                </page>
            </xpath>
        </field>
    </record>
</odoo>
