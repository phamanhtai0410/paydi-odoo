<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="list-mid">
            <div class="container ">
                <table class="table table-borderd">
                    <thead>
                        <tr>
                            <th scope="col">id</th>
                            <th scope="col">mid</th>
                            <th scope="col">Ngành nghề</th>
                            <th scope="col">Mô tả</th>
                            <th scope="col">#</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach='merchants' t-as='merchant'>
                            <td t-esc="merchant.get('id')"></td>
                            <td t-esc="merchant.get('mid')"></td>
                            <td t-esc="merchant.get('midMasterCode').get('desc')"></td>
                            <td t-esc="merchant.get('desc')"></td>
                            <td>
                                <button class="btn btn-info"> 
                                <i class="fa fa-edit"></i>    
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>

        </template>
    </data>

</odoo>