<?xml version="1.0" encoding="utf-8"?>
<odoo>

   

    <record id="view_mid_service_form" model="ir.ui.view">
        <field name="name">mms.mid.form</field>
        <field name="model">mms.mid</field>
        <field name="arch" type="xml">
            <form string="Thông tin">
                <group>
                    <field name="code"/>
                    <field name="mid_master_code"/>
                    <field name="status"/>
                  
                </group>
            </form>
           
        </field>
    </record>

    <record id="view_mid_m_service_tree" model="ir.ui.view">
        <field name="name">mms.mid.form</field>
        <field name="model">mms.mid</field>
        <field name="arch" type="xml">
            <tree string="Dịch vụ">
                <field name="code"/>
                <field name="mid_master_code"/>
                <field name="status"/>
               
            </tree>
        </field>
    </record>

</odoo>